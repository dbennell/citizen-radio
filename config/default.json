
{
  "stationName": "Radio Arc-Corp",
  "djName": "DJ Quantum",
  "debug": false,
  "uptimeHours": null,
  "uptimeMode": "track",
  "trackHistory": {
    "historySize": 20,
    "weights": { "id": 0, "intro": 0, "ad": 2, "dj": 60, "music": 100 }
  },
  "schedule": {
    "defaultPattern": [
      "music", "music", "ad", "music", "dj",
      "music", "music", "ad", "music", "intro"
    ],
    "autoSegways": {
      "enabled": true,
      "transitionChances": {
        "music->music": 0.75,
        "music->ad": 0.15,
        "music->dj": 0.85,
        "ad->music": 0.0,
        "ad->dj": 0.0,
        "dj->music": 0.95,
        "dj->ad": 0.20,
        "intro->music": 0.80,
        "intro->dj": 0.0,
        "intro->ad": 0.0,
        "music->intro": 0.0,
        "dj->intro": 0.0,
        "ad->intro": 0.0
      }
    }
  },
  "contentQueue": {
    "minQueueSize": 2,
    "maxQueueSize": 4
  },
  "djOptions": {
    "includePodcasts": true
  },
  "context": "You are playing the role of a (NPC) Radio DJ in the game world of Star Citizen.",
  "vibe": "A mainstream popular commercial radio station based in Area-18 on ArcCorp playing modern chart music.",
  "aiPrompts": {
    "dj": "A lively and enthusiastic (slightly sarcastic and comedic) radio host for a galactic space station. Add flair and personality to this regular dj talk segment! Only the text to be spoken!",
    "ad": "Generate compelling commercial voiceover for futuristic product advertisements. Only the text to be spoken! You are not the DJ, you are are 'Larry Scott' Advert Sales Guy.",
    "intro": "Create energetic station intros that captivate listeners. Only the text to be spoken!",
    "segway": "Write a seamless transition between segments. Only the text to be spoken!",
    "segwayFunny": "Before announcing the next track, throw in a quick, off-the-cuff, DJ-style joke, cheeky comment or thought of the day."
  },
  "segwayFunny": 0.25,
  "ttsProfiles": {
    "dj": "en-US-Chirp3-HD-Enceladus",
    "ad": "en-US-Chirp3-HD-Charon",
    "intro": "en-US-Chirp3-HD-Enceladus",
    "segway": "en-US-Chirp3-HD-Enceladus"
  },
  "ttsAllowedPatterns": [
    "en-US-Chirp3-HD-*",
    "en-UK-Chirp3-HD-*",
    "en-AU-Chirp3-HD-*",
    "en-US-Chirp-HD-*",
    "en-UK-Chirp-HD-*",
    "en-AU-Chirp-HD-*"
  ],
  "streamMode": "youtube",
  "youtube": {
    "rtmpUrl": "rtmp://a.rtmp.youtube.com/live2",
    "updateMetadata": true,
    "createAutomatically": false
  },
  "video": {
    "resolution": {
      "width": 1920,
      "height": 1080
    },
    "resizeMode": "height",
    "enablePadding": true
  },
  "ratingSystem": {
    "enabled": false,
    "defaultRating": 3,
    "minTickets": 1,
    "maxTickets": 5,
    "ratingPersistence": true,
    "displayOnStream": true,
    "streamDelay": 0,
    "postTrackWindow": 30
  },
  "analyticsEngine": {
    "enabled": true,
    "processingInterval": 3600000,
    "minRatingsThreshold": 3,
    "outlierThreshold": 2,
    "topBottomListSize": 10,
    "trendingTimeframe": 7
  },
  "recommendationSystem": {
    "enabled": true,
    "confidenceThreshold": 0.7,
    "maxRecommendations": 20,
    "refreshInterval": 86400000
  },
  "metadataIntegration": {
    "enabled": true,
    "updateThreshold": 5,
    "maxFeedbackPerTrack": 100,
    "sentimentAnalysis": true,
    "fallbackToFile": true
  },
  "enhancedEngagement": {
    "enabled": true,
    "maxStoredComments": 5,
    "commentExpirationMinutes": 30,
    "minSignificanceThreshold": 0.6,
    "keywordWeights": {
      "love": 0.8,
      "amazing": 0.7,
      "awesome": 0.7,
      "favorite": 0.9,
      "terrible": 0.8,
      "worst": 0.8
    },
    "ratingWeight": 0.5,
    "segwayReferenceChance": 0.7,
    "useLLMSentimentAnalysis": true
  },
  "overlayManager": {
    "emojiCacheSize": 200,
    "commentCacheSize": 50
  },
  "fileIO": {
    "chat": {
      "bufferSize": 64000,
      "flushInterval": 5000,
      "rotationSize": 10485760,
      "maxArchives": 10,
      "archiveDir": "archives/chat"
    },
    "feedback": {
      "bufferSize": 32000,
      "flushInterval": 10000,
      "rotationSize": 5242880,
      "maxArchives": 5,
      "archiveDir": "archives/feedback"
    },
    "ratings": {
      "bufferSize": 16000,
      "flushInterval": 15000,
      "rotationSize": 2097152,
      "maxArchives": 3,
      "archiveDir": "archives/ratings"
    },
    "processedIds": {
      "maxSize": 10000,
      "cleanupInterval": 3600000
    }
